# Neon Database (data storage)
NEON_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Firebase Auth
# Frontend config (VITE_ prefix = safe publishable keys)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin (server-side token verification)
# Get these from: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google OAuth (for YouTube API - separate from Firebase Auth)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Last.fm API (for genre/mood enrichment)
# Get your API key from https://www.last.fm/api/account/create
LASTFM_API_KEY=

# YouTube Data API (for video search/validation)
# Get your API key from https://console.cloud.google.com
YOUTUBE_API_KEY=

# Web Push (VAPID keys for browser notifications)
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourdomain.com

# Allowed origins for CORS (comma-separated, production domains)
# Dev origins (localhost:5173, localhost:8888) are always included
ALLOWED_ORIGINS=https://your-site.netlify.app

# Resend (email notifications)
# Get your API key from https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@yourdomain.com
